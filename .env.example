# Скопируйте файл в .env. Каналы и токены каждого пользователя
# настраиваются в интерфейсе выбранной папки, а не в этом файле.

# Как часто обновлять публичные данные автоматически
SYNC_INTERVAL_MINUTES=30

# Необязательно
HOST=127.0.0.1
PORT=8080

# Публичный HTTPS-адрес развёрнутого сервиса. Нужен для webhook.
# Пример: https://analytics.example.ru
PUBLIC_BASE_URL=
